{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "input",
            "message": "Use <TextField> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand-and-status/LockBadge/**",
              "components/brand-and-status/Roasty/**",
              "components/controls/DictSearchBar/**",
              "components/controls/Disclosure/**",
              "components/controls/FavButton/**",
              "components/controls/QuickChip/**",
              "components/controls/SettingsToggle/**",
              "components/controls/SpeakButton/**",
              "components/controls/TextField/**",
              "components/lesson-cards/AnswerFeedback/**",
              "components/lesson-cards/CardTakeaway/**",
              "components/lesson-cards/MCQCard/**",
              "components/lesson-cards/TrueFalseCard/**",
              "components/lesson-cards/VisualGuideCard/**",
              "components/navigation/PageTitle/**",
              "components/navigation/ProgressTopbar/**",
              "components/navigation/ScreenFooter/**",
              "components/navigation/SubScreenHeader/**",
              "components/navigation/TabBar/**",
              "components/progress-and-rewards/CollectionCard/**",
              "components/progress-and-rewards/PointsTally/**",
              "components/progress-and-rewards/RewardCard/**",
              "components/progress-and-rewards/WeekStrip/**",
              "components/rows/DictTermRow/**",
              "components/rows/FormRow/**",
              "components/rows/NavRow/**",
              "components/rows/ReplayRow/**",
              "components/rows/SavedRow/**",
              "components/sheets/ConfirmSheet/**",
              "components/sheets/Sheet/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|IBM Plex Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, IBM Plex Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerFeedback'] > JSXAttribute > JSXIdentifier[name!=/^(?:correct|state|size|label|right|wrong|text|children|onTermTap|marginTop|borderTop|tone|labelTone|bodySize|className|art|key|ref|className|style|children)$/]",
        "message": "<AnswerFeedback> doesn't accept that prop. Declared props: correct, state, size, label, right, wrong, text, children, onTermTap, marginTop, borderTop, tone, labelTone, bodySize, className, art."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerFeedback'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|correct|wrong|lesson|module|points|card|sleep|awake)$/]",
        "message": "<AnswerFeedback> state must be one of 'idle' | 'correct' | 'wrong' | 'lesson' | 'module' | 'points' | 'card' | 'sleep' | 'awake'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerFeedback'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:berry|accent)$/]",
        "message": "<AnswerFeedback> tone must be one of 'berry' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerFeedback'] > JSXAttribute[name.name='labelTone'] > Literal[value!=/^(?:neutral)$/]",
        "message": "<AnswerFeedback> labelTone must be one of 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerFeedback'] > JSXAttribute[name.name='bodySize'] > Literal[value!=/^(?:support|body)$/]",
        "message": "<AnswerFeedback> bodySize must be one of 'support' | 'body'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardTakeaway'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|text|marginTop|className|key|ref|className|style|children)$/]",
        "message": "<CardTakeaway> doesn't accept that prop. Declared props: label, text, marginTop, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollectionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:card|index|total|onOpen|stamped|challengeOpen|key|ref|className|style|children)$/]",
        "message": "<CollectionCard> doesn't accept that prop. Declared props: card, index, total, onOpen, stamped, challengeOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|body|lines|confirmLabel|cancelLabel|danger|onConfirm|onClose|key|ref|className|style|children)$/]",
        "message": "<ConfirmSheet> doesn't accept that prop. Declared props: open, title, body, lines, confirmLabel, cancelLabel, danger, onConfirm, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='DictSearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onClear|autoFocus|placeholder|key|ref|className|style|children)$/]",
        "message": "<DictSearchBar> doesn't accept that prop. Declared props: value, onChange, onClear, autoFocus, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='DictTermRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:term|learned|isFav|onOpen|onToggleFav|snippet|nudge|key|ref|className|style|children)$/]",
        "message": "<DictTermRow> doesn't accept that prop. Declared props: term, learned, isFav, onOpen, onToggleFav, snippet, nudge."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|header|below|trailing|glyph|glyphSize|glyphColor|trailingGap|open|defaultOpen|onToggle|openSignal|collapsible|animate|duration|divider|ariaLabel|headerAlign|headerPad|style|headerStyle|panelStyle|children|key|ref|className|style|children)$/]",
        "message": "<Disclosure> doesn't accept that prop. Declared props: label, header, below, trailing, glyph, glyphSize, glyphColor, trailingGap, open, defaultOpen, onToggle, openSignal, collapsible, animate, duration, divider, ariaLabel, headerAlign, headerPad, style, headerStyle, panelStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute[name.name='glyph'] > Literal[value!=/^(?:caret|plus|none)$/]",
        "message": "<Disclosure> glyph must be one of 'caret' | 'plus' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FavButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onClick|size|key|ref|className|style|children)$/]",
        "message": "<FavButton> doesn't accept that prop. Declared props: active, onClick, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<FormRow> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='MCQCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:card|onContinue|onCorrect|onTermTap|key|ref|className|style|children)$/]",
        "message": "<MCQCard> doesn't accept that prop. Declared props: card, onContinue, onCorrect, onTermTap."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sub|value|accent|dim|external|onClick|pending|pendingLabel|failed|toggle|toggleOn|onToggle|key|ref|className|style|children)$/]",
        "message": "<NavRow> doesn't accept that prop. Declared props: label, sub, value, accent, dim, external, onClick, pending, pendingLabel, failed, toggle, toggleOn, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|meta|clearActions|key|ref|className|style|children)$/]",
        "message": "<PageTitle> doesn't accept that prop. Declared props: children, meta, clearActions."
      },
      {
        "selector": "JSXOpeningElement[name.name='PointsTally'] > JSXAttribute > JSXIdentifier[name!=/^(?:earned|label|key|ref|className|style|children)$/]",
        "message": "<PointsTally> doesn't accept that prop. Declared props: earned, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressTopbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClose|pos|total|done|right|closeLabel|key|ref|className|style|children)$/]",
        "message": "<ProgressTopbar> doesn't accept that prop. Declared props: onClose, pos, total, done, right, closeLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|count|isMuted|onClick|describedBy|key|ref|className|style|children)$/]",
        "message": "<QuickChip> doesn't accept that prop. Declared props: label, icon, count, isMuted, onClick, describedBy."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReplayRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|icon|meta|onClick|locked|go|isPending|describedBy|key|ref|className|style|children)$/]",
        "message": "<ReplayRow> doesn't accept that prop. Declared props: title, sub, icon, meta, onClick, locked, go, isPending, describedBy."
      },
      {
        "selector": "JSXOpeningElement[name.name='RewardCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:reward|key|ref|className|style|children)$/]",
        "message": "<RewardCard> doesn't accept that prop. Declared props: reward."
      },
      {
        "selector": "JSXOpeningElement[name.name='Roasty'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|replayKey|style|roast|hat|gear|sprout|pointsAmount|plate|key|ref|className|style|children)$/]",
        "message": "<Roasty> doesn't accept that prop. Declared props: state, size, replayKey, style, roast, hat, gear, sprout, pointsAmount, plate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Roasty'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|correct|wrong|lesson|module|points|card|sleep|awake)$/]",
        "message": "<Roasty> state must be one of 'idle' | 'correct' | 'wrong' | 'lesson' | 'module' | 'points' | 'card' | 'sleep' | 'awake'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Roasty'] > JSXAttribute[name.name='roast'] > Literal[value!=/^(?:light|medium|dark|espresso)$/]",
        "message": "<Roasty> roast must be one of 'light' | 'medium' | 'dark' | 'espresso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Roasty'] > JSXAttribute[name.name='hat'] > Literal[value!=/^(?:none|beanie|field|cap)$/]",
        "message": "<Roasty> hat must be one of 'none' | 'beanie' | 'field' | 'cap'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Roasty'] > JSXAttribute[name.name='gear'] > Literal[value!=/^(?:none|glasses|sunglasses|scarf|headphones)$/]",
        "message": "<Roasty> gear must be one of 'none' | 'glasses' | 'sunglasses' | 'scarf' | 'headphones'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Roasty'] > JSXAttribute[name.name='sprout'] > Literal[value!=/^(?:none|leaf|flower|sprig)$/]",
        "message": "<Roasty> sprout must be one of 'none' | 'leaf' | 'flower' | 'sprig'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SavedRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|cat|sub|title|meta|onOpen|onToggleFav|key|ref|className|style|children)$/]",
        "message": "<SavedRow> doesn't accept that prop. Declared props: kind, cat, sub, title, meta, onOpen, onToggleFav."
      },
      {
        "selector": "JSXOpeningElement[name.name='SavedRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:lesson|card|term|visualGuide|game)$/]",
        "message": "<SavedRow> kind must be one of 'lesson' | 'card' | 'term' | 'visualGuide' | 'game'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<ScreenFooter> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingsToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|onChange|label|key|ref|className|style|children)$/]",
        "message": "<SettingsToggle> doesn't accept that prop. Declared props: on, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, onClose, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeakButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:word|pron|size|key|ref|className|style|children)$/]",
        "message": "<SpeakButton> doesn't accept that prop. Declared props: word, pron, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeakButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SpeakButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubScreenHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:scrolled|eyebrow|title|onBack|icon|right|ringBack|solid|key|ref|className|style|children)$/]",
        "message": "<SubScreenHeader> doesn't accept that prop. Declared props: scrolled, eyebrow, title, onBack, icon, right, ringBack, solid."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubScreenHeader'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:back|close)$/]",
        "message": "<SubScreenHeader> icon must be one of 'back' | 'close'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|isV1|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: active, onChange, isV1."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:learn|path|atlas|cards|profile)$/]",
        "message": "<TabBar> active must be one of 'learn' | 'path' | 'atlas' | 'cards' | 'profile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|maxLength|autoFocus|ariaLabel|onSubmit|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: value, onChange, placeholder, maxLength, autoFocus, ariaLabel, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrueFalseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:card|onContinue|onCorrect|onTermTap|key|ref|className|style|children)$/]",
        "message": "<TrueFalseCard> doesn't accept that prop. Declared props: card, onContinue, onCorrect, onTermTap."
      },
      {
        "selector": "JSXOpeningElement[name.name='VisualGuideCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:visualGuide|key|ref|className|style|children)$/]",
        "message": "<VisualGuideCard> doesn't accept that prop. Declared props: visualGuide."
      },
      {
        "selector": "JSXOpeningElement[name.name='VisualGuideCard'] > JSXAttribute[name.name='visualGuide'] > Literal[value!=/^(?:roast|grind|extraction|ratio|anatomy|variety|caffeine|distribution)$/]",
        "message": "<VisualGuideCard> visualGuide must be one of 'roast' | 'grind' | 'extraction' | 'ratio' | 'anatomy' | 'variety' | 'caffeine' | 'distribution'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|streak|frozen|key|ref|className|style|children)$/]",
        "message": "<WeekStrip> doesn't accept that prop. Declared props: size, streak, frozen."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekStrip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<WeekStrip> size must be one of 'sm' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
