{
  "name": "getbrewpath",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts e2e playwright.config.ts",
    "lint:fix": "eslint src scripts e2e playwright.config.ts --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:staged": "prettier --write",
    "check-format": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-cards": "tsx scripts/sync-cards.ts",
    "prepare": "husky",
    "preview": "pnpm write-static-headers && opennextjs-cloudflare build && opennextjs-cloudflare preview --env preview",
    "deploy": "pnpm write-static-headers && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "write-static-headers": "tsx scripts/write-static-headers.ts",
    "test:smoke": "tsx scripts/check-preview-stopped.ts && playwright test"
  },
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.18.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "clsx": "2.1.1",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unpdf": "1.8.1",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "packageManager": "pnpm@10.33.4"
}
