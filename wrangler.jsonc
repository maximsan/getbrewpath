{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getbrewpath",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Resizes the pictures shown with Next.js's <Image>: https://opennext.js.org/cloudflare/howtos/image
  "images": {
    "binding": "IMAGES",
  },
  // The site's domains. A deploy attaches them to this Worker and creates
  // their DNS records: https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
  "routes": [
    { "pattern": "getbrewpath.com", "custom_domain": true },
    { "pattern": "open.getbrewpath.com", "custom_domain": true },
    { "pattern": "www.getbrewpath.com", "custom_domain": true },
  ],
  "env": {
    // `pnpm preview` and the smoke tests run this, with no domains. With them,
    // the local preview rewrites every request to the first domain, so the
    // redirects per domain in `next.config.ts` could not be tested.
    "preview": {
      "routes": [],
      "images": {
        "binding": "IMAGES",
      },
    },
  },
}
