# Resend API key for the support form. Without it, the form reports that sending failed.
RESEND_API_KEY=

# Optional. The From line of support emails. Defaults to EMAIL_SUPPORT_SENDER in src/domains/site/site.ts.
SUPPORT_FROM_EMAIL=
# Optional. The inbox that receives support messages. Defaults to EMAIL_HELLO in src/domains/site/site.ts.
SUPPORT_TO_EMAIL=
